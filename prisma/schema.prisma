generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum FridgeType {
  NORMAL_FRIDGE
  NORMAL_FREEZER
  KIMCHI_FRIDGE
  SIDE_DISH_FRIDGE
}
enum FoodCategory {
  KIMCHI
  SIDE_DISH
  SOUP_STEW
  SAUCE_SEASONING
  BABY_FOOD
  MEAT_FISH
  VEGETABLE_FRUIT
  DAIRY
  ETC
}
enum KimchiRipeness {
  FRESH
  RIPE
  SOUR
}
enum BabyFoodStage {
  EARLY
  MIDDLE
  LATE
}
enum UserRole {
  ADMIN
  USER
}
enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}
enum MembershipStatus {
  ACTIVE
  LEFT
}
enum JoinStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role UserRole @default(USER)
  status UserStatus @default(PENDING)
  approvedAt DateTime?
  approvedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  memberships HouseholdMembership[]
  joinRequests JoinRequest[] @relation("Applicant")
  decisions JoinRequest[] @relation("Decider")
  meta ItemPersonalMeta[]
  shoppingItems ShoppingItem[]
  createdHouseholds Household[]
  invitations HouseholdInvitation[]
  @@map("users")
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
  @@map("sessions")
}
model Household {
  id String @id @default(cuid())
  name String
  createdById String?
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members HouseholdMembership[]
  invitations HouseholdInvitation[]
  joinRequests JoinRequest[]
  fridges Fridge[]
  shopping ShoppingItem[]
  @@map("households")
}
model HouseholdMembership {
  id String @id @default(cuid())
  householdId String
  userId String
  status MembershipStatus @default(ACTIVE)
  joinedAt DateTime @default(now())
  leftAt DateTime?
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([householdId, status])
  @@map("household_memberships")
}
model HouseholdInvitation {
  id String @id @default(cuid())
  householdId String
  codeHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdById String
  createdAt DateTime @default(now())
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])
  @@map("household_invitations")
}
model JoinRequest {
  id String @id @default(cuid())
  householdId String
  requesterId String
  status JoinStatus @default(PENDING)
  decidedById String?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  requester User @relation("Applicant", fields: [requesterId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("Decider", fields: [decidedById], references: [id])
  @@index([householdId, status])
  @@map("join_requests")
}
model Fridge {
  id String @id @default(cuid())
  name String
  type FridgeType
  householdId String
  household Household @relation(fields: [householdId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items FoodItem[]
  @@index([householdId])
  @@map("fridges")
}
model FoodItem {
  id String @id @default(cuid())
  name String
  category FoodCategory
  quantity Float?
  unit String?
  purchaseDate DateTime?
  expiryDate DateTime?
  openedAt DateTime?
  kimchiType String?
  kimchiRipeness KimchiRipeness?
  babyFoodStage BabyFoodStage?
  cubeCount Int?
  fridgeId String
  fridge Fridge @relation(fields: [fridgeId], references: [id], onDelete: Cascade)
  meta ItemPersonalMeta[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([fridgeId])
  @@index([expiryDate])
  @@index([category])
  @@map("food_items")
}
model ItemPersonalMeta {
  id String @id @default(cuid())
  userId String
  foodItemId String
  cookingPurpose String?
  personalNote String?
  plannedQuantity Float?
  plannedUnit String?
  pinned Boolean @default(false)
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  @@unique([userId, foodItemId])
  @@map("item_personal_meta")
}
model ShoppingItem {
  id String @id @default(cuid())
  householdId String
  addedById String
  name String
  checked Boolean @default(false)
  createdAt DateTime @default(now())
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  addedBy User @relation(fields: [addedById], references: [id])
  @@index([householdId])
  @@map("shopping_items")
}
model RateLimit {
  key String @id
  count Int @default(0)
  resetAt DateTime
  @@map("rate_limits")
}
model AuditEvent {
  id String @id @default(cuid())
  actorId String?
  targetId String?
  action String
  createdAt DateTime @default(now())
  @@map("audit_events")
}
model FoodPreset {
  id String @id @default(cuid())
  name String @unique
  category FoodCategory
  defaultShelfLife Int?
  defaultUnit String?
  isKimchi Boolean @default(false)
  kimchiType String?
  isBabyFood Boolean @default(false)
  babyFoodStage BabyFoodStage?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("food_presets")
}
